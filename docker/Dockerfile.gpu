# syntax=docker/dockerfile:1
# ===========================================================================
# Laya Engine -- GPU image (NVIDIA, Linux host, CUDA 12 + cuDNN 9).
#
# Requirements on the host:
#   - NVIDIA driver (>= 525) and NVIDIA Container Toolkit
#   - run with:  docker run --gpus all ...
#     or, with compose:  COMPOSE_PROFILES=gpu docker compose up --build laya-gpu
#
# The CUDA 12 / cuDNN 9 libraries come from the NVIDIA base image, so
# scripts/fetch-cuda.sh is not needed here.
# ===========================================================================
FROM golang:1.26-bookworm AS builder

ARG ORT_VERSION=1.25.0

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# ONNX Runtime 1.25.0 GPU build: contains onnxruntime_providers_cuda.so.
RUN curl -fL --retry 3 -o /tmp/ort.tgz \
      "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-gpu-${ORT_VERSION}.tgz" \
 && tar -xzf /tmp/ort.tgz -C /tmp \
 && mv "/tmp/onnxruntime-linux-x64-gpu-${ORT_VERSION}" /opt/ort \
 && rm /tmp/ort.tgz

ENV CGO_ENABLED=1
RUN go build -o /out/laya-server ./cmd/laya-server

# ---------------------------------------------------------------------------
# cudnn-runtime already carries cuBLAS / cuFFT / cuDNN 9 runtime libraries.
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN mkdir -p /app/logs

COPY --from=builder /opt/ort/lib/libonnxruntime.so* /app/lib/
COPY --from=builder /opt/ort/lib/libonnxruntime_providers_cuda.so /app/lib/
COPY --from=builder /opt/ort/lib/libonnxruntime_providers_shared.so /app/lib/
COPY --from=builder /out/laya-server /app/bin/laya-server
COPY models/model-manifest.json /app/models/model-manifest.json

ENV LAYA_ADDR=0.0.0.0:8095 \
    LAYA_MODEL=/app/models/multilingual-fp16.onnx \
    LAYA_TOKENIZER=/app/models/tokenizer.json \
    LAYA_ORT=/app/lib/libonnxruntime.so \
    LAYA_DEVICE=cuda \
    LAYA_DEVICE_ID=0 \
    LAYA_WARMUP=true \
    LAYA_LOG=/app/logs/laya-server.log \
    LD_LIBRARY_PATH=/app/lib:/usr/local/cuda/lib64

EXPOSE 8095

HEALTHCHECK --interval=30s --timeout=3s --start-period=180s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8095/health || exit 1

ENTRYPOINT ["/app/bin/laya-server"]
CMD ["-addr", "0.0.0.0:8095", "-device", "cuda", "-device-id", "0"]
